{
  "name": "@noy-db/on-totp",
  "version": "0.8.0",
  "description": "TOTP (RFC 6238) authenticator-app second factor for noy-db — generate secrets, otpauth:// provisioning URIs, and constant-time code verification. Zero dependencies (HMAC-SHA1 via Web Crypto). Part of the @noy-db/on-* authentication family.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/on/tree/main/on-totp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/on.git",
    "directory": "on-totp"
  },
  "bugs": {
    "url": "https://github.com/noy-db/on/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "noy-db",
    "on-totp",
    "totp",
    "rfc-6238",
    "2fa",
    "mfa",
    "authenticator"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
