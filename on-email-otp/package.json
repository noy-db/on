{
  "name": "@noy-db/on-email-otp",
  "version": "0.8.0",
  "description": "Email OTP second factor for noy-db — generates time-boxed one-time codes, delivers via a user-supplied transport (SMTP / SES / Postmark / any fn), and verifies in constant time. Part of the @noy-db/on-* authentication family.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/on/tree/main/on-email-otp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/on.git",
    "directory": "on-email-otp"
  },
  "bugs": {
    "url": "https://github.com/noy-db/on/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "noy-db",
    "on-email-otp",
    "email",
    "otp",
    "2fa",
    "mfa"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
